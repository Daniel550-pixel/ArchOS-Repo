# ArchOS environment template
# Never commit real credentials. Copy this file to a local environment file and replace placeholders locally.

# UAE News intelligence sensor
NEWS_API_KEY=""
UAE_NEWS_API_KEY=""
NEWS_API_BASE_URL="https://newsapi.org/v2"
NEWS_COUNTRY="ae"
NEWS_LANGUAGE="en"
NEWS_FETCH_INTERVAL=15

# Database
DATABASE_URL="postgresql+asyncpg://postgres:<PASSWORD>@localhost:5432/uae_intelligence"

# AI providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ARCHOS_CLAUDE_MODEL="claude-sonnet-4-6"

# Ox Alpha / GLM-5.3-Flash reasoning lane
# Ox Alpha was the anonymous preview name; the revealed model is GLM-5.3-Flash.
OX_ALPHA_API_KEY=""
OX_ALPHA_BASE_URL="https://openrouter.ai/api/v1"
ARCHOS_OX_ALPHA_MODEL="z-ai/glm-5.3-flash"
OX_ALPHA_TIMEOUT_SECONDS="45"

# Voice synthesis
VITE_ELEVENLABS_API_KEY=""

# Administrative security
# Generate a strong local value. Do not use a real credential in this template.
ADMIN_API_KEY="<GENERATE_A_RANDOM_ADMIN_KEY>"
ENVIRONMENT="development"
APP_URL=""
